# 複製此檔為 .env.local（不會進版控）並填入實際值
# 前端 Vite 只會載入 VITE_ 開頭的變數

# Google OAuth 2.0 用戶端 ID（Google Cloud Console 申請，詳見 DEPLOY.md）
# 前後端必須使用同一個 Client ID
VITE_GOOGLE_CLIENT_ID=

# 各服務位址（本機 Vite dev server 預設同 host 的 8001-8004 port，通常不用設）
# VITE_LOCATION_SERVICE_URL=
# VITE_EVENT_SERVICE_URL=
# VITE_NOTIFICATION_WS_URL=
# VITE_NOTIFICATION_SERVICE_URL=
# VITE_AI_SERVICE_URL=
