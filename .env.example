REDIS_URL=redis://localhost:6379/0
USER_LOCATION_KEY=realtime_map_notice:user:locations
USER_LAST_SEEN_PREFIX=realtime_map_notice:user:last_seen
DEFAULT_ALERT_RADIUS_METERS=500
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Push（notification-service）；三項都設定後才會啟用手機通知欄推播
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 反垃圾訊息（event-service）；設為 0 表示停用該規則
EVENT_RATE_LIMIT_PER_MINUTE=3
EVENT_MIN_INTERVAL_SECONDS=30
EVENT_DUPLICATE_WINDOW_SECONDS=300
EVENT_MAX_ACTIVE_PER_USER=5

# AI 內容審核（ai-service）：off / keyword / llm
AI_PROVIDER=openai
MODERATION_PROVIDER=keyword
ANALYSIS_PROVIDER=keyword
# keyword provider 封鎖詞（逗號分隔；留空用預設清單）
MODERATION_BLOCKED_KEYWORDS=
# OpenAI 相容 API 設定（AI_PROVIDER=openai 時使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Google AI Studio Gemini 設定（AI_PROVIDER=gemini 時使用）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=8
